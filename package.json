{
  "name": "core-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.0",
  "scripts": {
    "dev": "node scripts/copy-map-worker.mjs && next dev",
    "build": "node scripts/copy-map-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:styles": "stylelint \"**/*.{css,scss,pcss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check \"{docs,tests,src/components/common,src/test}/**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0"
    ],
    "*.{cjs,mjs,cts,mts,js,jsx,ts,tsx,json,md,css,scss,pcss}": [
      "prettier --write"
    ],
    "*.{css,scss,pcss}": [
      "stylelint --allow-empty-input"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@protomaps/basemaps": "5.7.2",
    "@skylab-kulubu/skylcn-ui": "https://github.com/skylab-kulubu/skylcn-ui/releases/download/v0.3.0-onizleme.1/skylab-kulubu-skylcn-ui-0.3.0-onizleme.1.tgz",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "lucide-react": "^1.46.0",
    "maplibre-gl": "6.17.0",
    "next": "16.4.6",
    "pmtiles": "4.5.0",
    "qr-scanner": "1.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "^7.69.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@next/eslint-plugin-next": "^16.1.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "motion": "^13.4.4",
    "msw": "^2.12.4",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-tailwindcss": "^1.0.0",
    "stylelint-order": "^7.0.0",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
